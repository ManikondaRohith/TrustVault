# =====================================================================
# TrustVault configuration. Copy to backend/.env (start.ps1 does this and
# fills every secret with random values). Never commit backend/.env.
# =====================================================================

# production | development   (development allows the "outbox" OTP provider and /api/docs)
APP_ENV=production

# ---- Database --------------------------------------------------------
# Host "db" is the compose service name. The password must equal MYSQL_PASSWORD in
# backend/db.env (see backend/db.env.example; the API never sees the root password).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ---- Secrets: 32+ random characters each -----------------------------
JWT_SECRET=__GENERATE__
OTP_PEPPER=__GENERATE__
PASSCODE_PEPPER=__GENERATE__

# ---- Web -------------------------------------------------------------
# Secure cookies are sent over HTTPS, and over http://localhost by modern browsers.
COOKIE_SECURE=true
# Exact origins allowed to send state-changing requests (comma separated).
ALLOWED_ORIGINS=http://localhost:8000
# Set true only when a reverse proxy you control sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
SESSION_IDLE_MINUTES=15

# ---- One-time code delivery (email only: sign-up and forgot password) ----
# EMAIL_PROVIDER: smtp | sendgrid | outbox(dev only)
EMAIL_PROVIDER=smtp
# A plain address (name is added automatically) or: TrustVault <no-reply@your-domain.example>
MAIL_FROM=no-reply@your-domain.example

SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

SENDGRID_API_KEY=

# Dev only: where the outbox provider writes codes (inside the container).
OTP_OUTBOX_PATH=/app/data/otp_outbox.log

# ---- Seed accounts (first boot only) ------------------------------------
# An email lets the account use "Forgot password". Optional.
SEED_MANIKONDA_ROHITH_EMAIL=
SEED_NAVEEN_EMAIL=
SEED_GOWTHAM_EMAIL=
SEED_KRISHNA_EMAIL=
SEED_KEERTHI_EMAIL=
INITIAL_CREDENTIALS_FILE=/app/data/initial_credentials.txt

# ---- Rate limits (per API process) ---------------------------------------
RATE_SIGNUP_PER_10MIN=10
RATE_LOGIN_PER_MIN=30
